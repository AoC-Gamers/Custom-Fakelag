# Copy to .env and override only what you need locally.

# Common paths
# DEPS_DIR=C:\GitHub\L4D2_Custom_Fakelag\.deps
# BUILD_DIR=C:\GitHub\L4D2_Custom_Fakelag\.build\windows-l4d2
# HL2SDK_DIR=C:\GitHub\L4D2_Custom_Fakelag\.deps\hl2sdk-l4d2
# SOURCEMOD_DIR=C:\GitHub\L4D2_Custom_Fakelag\.deps\sourcemod-1.12
# MMSOURCE_DIR=C:\GitHub\L4D2_Custom_Fakelag\.deps\mmsource-1.12
# AMBUILD_DIR=C:\GitHub\L4D2_Custom_Fakelag\.deps\ambuild
# VENV_DIR=C:\GitHub\L4D2_Custom_Fakelag\.deps\.venv-windows
# CONFIGURE_SCRIPT=C:\GitHub\L4D2_Custom_Fakelag\configure.py

# Windows-specific overrides
# VCVARSALL_PATH=C:\Program Files\Microsoft Visual Studio\18\Insiders\VC\Auxiliary\Build\vcvarsall.bat

# Explicit local Sonar analysis (no CI upload)
# SONAR_HOST_URL=https://sonarqube.example.invalid
# SONAR_PROJECT_KEY=Custom-Fakelag
# SONAR_PROJECT_NAME=Custom-Fakelag
# SONAR_QUALITY_GATE_WAIT=true
# SONAR_QUALITY_GATE_TIMEOUT=300
# SONAR_CPPCHECK=cppcheck
# SONAR_SCANNER=sonar-scanner
# SONAR_COVERAGE_RECEIPT=.build/coverage/native-001/receipt.json
# SONAR_PYTHON_COVERAGE_RECEIPT=.build/coverage/python-001/receipt.json
