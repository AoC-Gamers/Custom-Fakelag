root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h,c,hpp,hh,cc}]
indent_style = tab
indent_size = 4

[*.{py,ps1,yml,yaml,md,txt,sp,inc}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
