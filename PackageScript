import json
import os

# This is where the files will be output to
# package is the default
builder.SetBuildFolder('package')

folder_map = {}


def GetFolder(path):
  norm_path = os.path.normpath(path)
  if norm_path not in folder_map:
    folder_map[norm_path] = builder.AddFolder(norm_path)
  return folder_map[norm_path]


manifest_path = os.path.join(builder.sourcePath, 'plugin-package-map.json')
with open(manifest_path, 'r', encoding='utf-8') as f:
  manifest = json.load(f)

build_manifest = manifest.get('build', {})
artifact_manifest = manifest.get('artifact', {}).get('addons', {}).get('sourcemod', {})


def AddCopy(source_path, dest_path):
  builder.AddCopy(source_path, GetFolder(dest_path))


def CopySelectedFiles(src_root, dest_root, files):
  for source_file in files:
    source_path = os.path.join(builder.sourcePath, src_root, source_file)
    relative_parent = os.path.dirname(source_file)
    destination_root = os.path.join(dest_root, relative_parent) if relative_parent else dest_root
    AddCopy(source_path, destination_root)


def CopySelectedDirs(src_root, dest_root, dirs):
  for source_dir in dirs:
    source_path = os.path.join(builder.sourcePath, src_root, source_dir)
    for dirpath, _, filenames in os.walk(source_path):
      rel_dir = os.path.relpath(dirpath, os.path.join(builder.sourcePath, src_root))
      destination_root = os.path.join(dest_root, rel_dir) if rel_dir != '.' else dest_root
      for filename in filenames:
        AddCopy(os.path.join(dirpath, filename), destination_root)


def CopyAllChildren(src_root, dest_root):
  source_path = os.path.join(builder.sourcePath, src_root)
  for dirpath, _, filenames in os.walk(source_path):
    rel_dir = os.path.relpath(dirpath, source_path)
    destination_root = os.path.join(dest_root, rel_dir) if rel_dir != '.' else dest_root
    for filename in filenames:
      AddCopy(os.path.join(dirpath, filename), destination_root)


def CopyManifestSection(section, src_root, dest_root):
  if section.get('all', False):
    CopyAllChildren(src_root, dest_root)
  if 'files' in section:
    CopySelectedFiles(src_root, dest_root, section['files'])
  if 'dirs' in section:
    CopySelectedDirs(src_root, dest_root, section['dirs'])
  for key, value in section.items():
    if key in ('all', 'files', 'dirs'):
      continue
    if isinstance(value, dict):
      CopyManifestSection(value, os.path.join(src_root, key), os.path.join(dest_root, key))


CopyManifestSection(artifact_manifest.get('scripting', {}), 'scripting', 'addons/sourcemod/scripting')
CopyManifestSection(artifact_manifest.get('translations', {}), 'translations', 'addons/sourcemod/translations')
CopyManifestSection(artifact_manifest.get('gamedata', {}), 'gamedata', 'addons/sourcemod/gamedata')

# Copy binaries.
plugin_buckets = build_manifest.get('plugins', {})
extension_buckets = build_manifest.get('extensions', {})
extension_records = []

for bucket, extensions in extension_buckets.items():
  for extension_stem in extensions:
    extension_records.append((bucket, extension_stem))

if len(extension_records) != len(Extension.extensions):
  raise Exception(
    'build.extensions declares {0} entries, but AMBuild produced {1} extension tasks.'.format(
      len(extension_records),
      len(Extension.extensions),
    )
  )

for cxx_task, (bucket, extension_stem) in zip(Extension.extensions, extension_records):
  destination_root = 'addons/sourcemod/extensions'
  if bucket != 'root':
    destination_root = os.path.join(destination_root, bucket)
  builder.AddCopy(cxx_task.binary, GetFolder(destination_root))

for bucket, plugins in plugin_buckets.items():
  destination_root = 'addons/sourcemod/plugins'
  if bucket != 'root':
    destination_root = os.path.join(destination_root, bucket)
  for plugin_stem in plugins:
    plugin_binary = os.path.join(builder.buildPath, '%s.smx' % plugin_stem)
    if os.path.exists(plugin_binary):
      builder.AddCopy(plugin_binary, GetFolder(destination_root))
