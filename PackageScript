import os

# This is where the files will be output to
# package is the default
builder.SetBuildFolder('package')

# Add any folders you need to this list
folder_list = [
  'addons/sourcemod/extensions',
  'addons/sourcemod/plugins',
  'addons/sourcemod/scripting',
  'addons/sourcemod/scripting/player_fakelag',
  'addons/sourcemod/scripting/include',
  'addons/sourcemod/translations',
  'addons/sourcemod/gamedata',
]

# Create the distribution folder hierarchy.
folder_map = {}
for folder in folder_list:
  norm_folder = os.path.normpath(folder)
  folder_map[folder] = builder.AddFolder(norm_folder)

# Do all straight-up file copies from the source tree.
def CopyFiles(src, dest, files):
  if not dest:
    dest = src
  dest_entry = folder_map[dest]
  for source_file in files:
    source_path = os.path.join(builder.sourcePath, src, source_file)
    builder.AddCopy(source_path, dest_entry)

CopyFiles('scripting/include', 'addons/sourcemod/scripting/include',
  [ 'custom_fakelag.inc',
    'player_fakelag.inc', ]
)

CopyFiles('gamedata', 'addons/sourcemod/gamedata',
  [ 'custom_fakelag.games.txt', ]
)

CopyFiles('translations', 'addons/sourcemod/translations',
  [ 'player_fakelag.phrases.txt', ]
)

CopyFiles('scripting', 'addons/sourcemod/scripting',
  [ 'player_fakelag.sp', ]
)

CopyFiles('scripting/player_fakelag', 'addons/sourcemod/scripting/player_fakelag',
  [ 'latency.sp',
    'helpers.sp',
    'balance.sp',
    'vote.sp',
    'natives.sp', ]
)

# Copy binaries.
for cxx_task in Extension.extensions:
  builder.AddCopy(cxx_task.binary, folder_map['addons/sourcemod/extensions'])

runtime_libs = [
  'libtier0_srv.so',
  'libvstdlib_srv.so',
  'libtier0.so',
  'libvstdlib.so',
  'tier0_i486.so',
  'vstdlib_i486.so',
  'libtier0.dylib',
  'libvstdlib.dylib',
]

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]

  candidate_lib_dirs = [
    os.path.join(sdk.path, 'lib', 'linux'),
    os.path.join(sdk.path, 'lib', 'mac'),
    os.path.join(sdk.path, 'linux_sdk'),
    os.path.join(sdk.path, 'lib', 'public', 'linux32'),
    os.path.join(sdk.path, 'lib', 'public', 'osx32'),
  ]

  for lib_dir in candidate_lib_dirs:
    if not os.path.isdir(lib_dir):
      continue

    for runtime_lib in runtime_libs:
      runtime_lib_path = os.path.join(lib_dir, runtime_lib)
      if os.path.exists(runtime_lib_path):
        builder.AddCopy(runtime_lib_path, folder_map['addons/sourcemod/extensions'])

player_fakelag_binary = os.path.join(builder.buildPath, 'player_fakelag.smx')
if os.path.exists(player_fakelag_binary):
  builder.AddCopy(player_fakelag_binary, folder_map['addons/sourcemod/plugins'])
